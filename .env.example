# ============================================================================
# ERP HomeMart — Variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo a `.env.local` para desarrollo local.
# En Vercel: Project Settings → Environment Variables (Production / Preview).
# NUNCA subas el archivo `.env` o `.env.local` al repositorio.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) OBLIGATORIAS — Firebase Admin SDK (PRIVADAS, solo servidor)
#    Firebase Console → Project settings → Service accounts →
#    "Generate new private key". Del JSON descargado:
#      client_email  -> FIREBASE_CLIENT_EMAIL
#      private_key   -> FIREBASE_PRIVATE_KEY
#
#    FIREBASE_PRIVATE_KEY: pega el valor completo entre comillas dobles,
#    conservando los `\n` literales tal como aparecen en el JSON.
#
#    Estas variables NUNCA llevan el prefijo NEXT_PUBLIC y jamás llegan al
#    navegador.
# ---------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@control-de-59fbd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Alternativa a las dos anteriores: el JSON completo del service account
# codificado en base64 (evita problemas con los saltos de línea).
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------------------------------------------------------------------------
# 2) OBLIGATORIA — Seguridad de las tareas programadas
#    Vercel Cron envía el header `Authorization: Bearer $CRON_SECRET`.
#    Usa una cadena aleatoria larga.
# ---------------------------------------------------------------------------
CRON_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# ---------------------------------------------------------------------------
# 3) OPCIONALES — Configuración web de Firebase
#    El proyecto `control-de-59fbd` ya viene configurado por defecto en
#    `src/lib/firebase/config.ts` (son valores públicos, no secretos).
#    Define estas variables SOLO si quieres apuntar la aplicación a otro
#    proyecto de Firebase sin tocar el código.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=otro-proyecto.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=otro-proyecto
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=otro-proyecto.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=otro-proyecto
# FIREBASE_STORAGE_BUCKET=otro-proyecto.firebasestorage.app

# ---------------------------------------------------------------------------
# 4) OPCIONALES — Comportamiento de la sesión
# ---------------------------------------------------------------------------
# Duración de la cookie de sesión en días (máx. 14 según Firebase).
SESSION_COOKIE_DAYS=5

# Comprueba en cada petición que los tokens no hayan sido revocados.
# Ponlo en "false" solo si necesitas reducir latencia y aceptas que
# desactivar un usuario tarde hasta el vencimiento de su cookie.
# SESSION_CHECK_REVOKED=true

# ---------------------------------------------------------------------------
# 5) OPCIONALES — Emuladores (solo desarrollo local / testing)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---------------------------------------------------------------------------
# 6) OPCIONALES — Seed (solo desarrollo, nunca en producción)
# ---------------------------------------------------------------------------
SEED_ORG_NAME=HomeMart
SEED_ADMIN_EMAIL=admin@homemart.test
SEED_ADMIN_PASSWORD=Admin123!
